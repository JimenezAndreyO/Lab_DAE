<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <!-- Arranca la app de Express con "bin/www". Para depurar, deja stdoutLogEnabled="true"
         (necesita la carpeta "logs" dentro de wwwroot); luego ponlo en "false". -->
    <httpPlatform processPath="node"
                  arguments=".\bin\www"
                  startupTimeLimit="60"
                  stdoutLogEnabled="true"
                  stdoutLogFile=".\logs\node">
      <environmentVariables>
        <environmentVariable name="NODE_ENV" value="production" />
      </environmentVariables>
    </httpPlatform>
  </system.webServer>
</configuration>